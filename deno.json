{
	"name": "@danet/graphql",
	"version": "0.1.0",
	"minimumDependencyAge": "1h",
	"description": "GraphQL module for Danet: serve a schema-first GraphQL endpoint from your application with DI-resolved resolvers, guards and an optional GraphiQL playground.",
	"license": "MIT",
	"exports": {
		".": "./mod.ts"
	},
	"lint": {
		"include": [
			"src/"
		],
		"exclude": [
			"node_modules/",
			"./**/*.test.ts"
		]
	},
	"fmt": {
		"options": {
			"singleQuote": true,
			"useTabs": true
		},
		"exclude": [
			"./node_modules/",
			"./graphify-out/",
			"./.claude/",
			"./openspec/"
		]
	},
	"publish": {
		"exclude": [
			"./spec",
			".github",
			"./graphify-out/",
			"./.claude/",
			"./openspec/"
		]
	},
	"compilerOptions": {
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true
	},
	"nodeModulesDir": "auto",
	"tasks": {
		"test": "NO_LOG=true deno test -A spec/"
	},
	"imports": {
		"@danet/graphql": "./mod.ts",
		"@danet/core": "jsr:@danet/core@^2.12.0",
		"@danet/core/metadata": "jsr:@danet/core@^2.12.0/metadata",
		"@danet/core/hook": "jsr:@danet/core@^2.12.0/hook",
		"graphql": "npm:graphql@16.11.0",
		"@std/assert": "jsr:@std/assert@1.0.3"
	}
}
